{
  "name": "arth-rakshak",
  "version": "1.0.0",
  "private": true,
  "description": "AI Financial Coach \u2014 Mastra + Groq + MongoDB (Mongoose), Express API, Vite/Tailwind UI.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "npm install && npm --prefix frontend install",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "build:all": "npm run build:web && npm run build"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.61",
    "@mastra/core": "^1.77.0",
    "@mastra/memory": "^1.37.1",
    "@mastra/mongodb": "^1.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
