# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV should be in [development, test, production]
PORT=8000
# The Express server serves the built UI (frontend/dist) on the same origin, so CORS is OFF by default.
# Only set this if a different origin calls the API (comma-separated; avoid "*" in production).
# CORS_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops to trust for client IPs (rate limiting). Leave unset if not behind a proxy.
# TRUST_PROXY=1
# Override where the built Vite app is served from (default: ./frontend/dist)
# FRONTEND_DIST_DIR=

# ── Groq (replaces GOOGLE_API_KEY / Gemini) ───────────────────────────────
GROQ_API_KEY=gsk_your_key_here
# Must support tool calling. openai/gpt-oss-120b also supports strict JSON-schema output on Groq.
GROQ_MODEL=openai/gpt-oss-120b
# "native" = Groq json_schema response format (gpt-oss, etc.)
# "prompt" = inject the schema into the prompt (for models without json_schema support)
GROQ_STRUCTURED_OUTPUT=native
# low | medium | high (gpt-oss models only; unset = not sent). Defaults for gpt-oss: low for both (set specialists to medium if your tier has token headroom).
# GROQ_REASONING_EFFORT_COACH=low
# GROQ_REASONING_EFFORT_SPECIALISTS=low

# ── MongoDB (Mongoose = financial data, Mastra store = chat memory) ───────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=finance_coach
MONGODB_MAX_POOL_SIZE=10
# Set to false in production and build indexes in a deploy step instead
MONGOOSE_AUTO_INDEX=true

# ── Authentication (own auth system: users in MongoDB, bcrypt, JWT) ──────
# HS256 signing secret, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# DEV ONLY: accept an "x-user-id" header instead of a JWT. Refused when NODE_ENV=production.
ALLOW_INSECURE_DEV_AUTH=false

# ── Mastra Memory (conversation history only) ─────────────────────────────
# Messages replayed to the model each turn (lower = fewer tokens)
MEMORY_LAST_MESSAGES=8
